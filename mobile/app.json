{
  "expo": {
    "name": "Monetra",
    "slug": "monetra-mobile",
    "scheme": "monetra",
    "version": "0.1.4",
    "icon": "./assets/monetra-app-icon.png",
    "splash": {
      "image": "./assets/monetra-app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.monetra.mobile",
      "allowBackup": false,
      "versionCode": 12,
      "adaptiveIcon": {
        "foregroundImage": "./assets/monetra-app-icon.png",
        "backgroundColor": "#0F1117"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/with-lets-encrypt-roots/index.cjs"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
