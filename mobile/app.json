{
  "expo": {
    "name": "Monetra",
    "slug": "monetra-mobile",
    "scheme": "monetra",
    "version": "0.2.0",
    "icon": "./assets/monetra-app-icon.png",
    "splash": {
      "image": "./assets/monetra-app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "orientation": "default",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.monetra.mobile",
      "allowBackup": false,
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/monetra-app-icon.png",
        "backgroundColor": "#0F1117"
      }
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
