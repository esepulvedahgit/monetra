#: app/templates/main/guia.html:578
msgid "Configuración → IA · Telegram"
msgstr ""

#: app/templates/main/guia.html:578
msgid "para que los usuarios sin clave propia también puedan usar el bot."
msgstr ""

#: app/templates/main/guia.html:583
msgid ""
"Si el administrador no configuró el bot, la sección Telegram en "
"Configuración aparece deshabilitada. Debe definir"
