# Flask
FLASK_DEBUG=0
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-larga

# Base de datos MySQL (Plesk o externo)
DB_HOST=IP_O_HOSTNAME_DEL_SERVIDOR
DB_PORT=3306
DB_NAME=nombre_base_de_datos
DB_USER=usuario_db
DB_PASSWORD=password_db

# Cifrado de campos sensibles (Fernet)
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# JWT para la API
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ── Rate limiting / defensa anti fuerza-bruta en el login ─────────────────────
# Backend de Flask-Limiter para los contadores por IP (login, registro, reset).
#   redis://HOST:6379/0   contador compartido entre workers (recomendado si la
#                         app está expuesta directamente a internet).
#                         Fuera de Docker suele ser redis://localhost:6379/0.
#   memory://             (default) contador en memoria; no se comparte entre
#                         workers ni sobrevive a reinicios. OK detrás de un WAF.
RATELIMIT_STORAGE_URI=memory://

# ── Bot de Telegram (opcional) ────────────────────────────────────────────────
# Sin estas variables la tarjeta de Telegram queda deshabilitada en Configuración.
#
# 1. Crea un bot con @BotFather → /newbot → copia el token aquí
TELEGRAM_BOT_TOKEN=
#
# 2. Username del bot sin @ (ej. MoneyTrackerBot)
#    Se usa para generar el deep link t.me/<username>?start=<código>
TELEGRAM_BOT_USERNAME=
#
# 3. Secreto para validar que los webhooks vienen de Telegram (no de terceros)
#    Genera con: python -c "import secrets; print(secrets.token_hex(32))"
TELEGRAM_WEBHOOK_SECRET=
#
# 4. URL pública del servidor — Telegram la usa para registrar el webhook al arrancar
#    En desarrollo usa ngrok: ngrok http 5000 → copia la URL https
SERVER_URL=https://tu-dominio.com
