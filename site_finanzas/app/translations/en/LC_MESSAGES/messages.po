# ── Login message ──
msgid "Por favor inicia sesión para acceder."
msgstr "Please log in to access this page."

# ── Auth routes ──
msgid "Cuenta creada exitosamente. Ya puedes iniciar sesión."
msgstr "Account created successfully. You can now log in."

msgid "¡Bienvenido, %(username)s!"
msgstr "Welcome, %(username)s!"

msgid "Email o contraseña incorrectos."
msgstr "Incorrect email or password."

msgid "Si el correo existe y tiene recuperación configurada, recibirás instrucciones enviadas mediante tu propio SMTP."
msgstr "If the email exists and has recovery configured, you will receive instructions sent via your own SMTP."

msgid "El enlace de recuperación es inválido o ha expirado."
msgstr "The recovery link is invalid or has expired."

msgid "Tu contraseña ha sido actualizada exitosamente."
msgstr "Your password has been updated successfully."

