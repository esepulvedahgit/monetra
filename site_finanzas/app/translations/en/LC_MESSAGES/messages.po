# ── WebAuthn / Biometric auth ──
msgid "Ingresar con Face ID / Huella"
msgstr "Sign in with Face ID / Fingerprint"

msgid "Autenticación biométrica"
msgstr "Biometric authentication"

msgid "Registrar este dispositivo"
msgstr "Register this device"

msgid "Cambiar dispositivo"
msgstr "Change device"

msgid "Inicia sesión con Face ID, huella dactilar o Windows Hello desde tu dispositivo móvil. El dispositivo hace la verificación — Monetra nunca almacena datos biométricos."
msgstr "Sign in with Face ID, fingerprint, or Windows Hello from your mobile device. The device handles verification — Monetra never stores biometric data."

msgid "Dispositivo registrado"
msgstr "Registered device"

msgid "Registrado el"
msgstr "Registered on"

msgid "Tu navegador no soporta autenticación biométrica."
msgstr "Your browser does not support biometric authentication."

msgid "Dispositivo registrado correctamente. Recarga la página para ver los cambios."
msgstr "Device registered successfully. Reload the page to see the changes."

msgid "Registro cancelado."
msgstr "Registration cancelled."

msgid "Error al registrar el dispositivo."
msgstr "Error registering the device."

msgid "¿Eliminar el dispositivo biométrico registrado? Podrás seguir usando tu contraseña."
msgstr "Delete the registered biometric device? You can still use your password."

msgid "Ingresa tu correo primero."
msgstr "Enter your email first."

msgid "Autenticación cancelada."
msgstr "Authentication cancelled."

msgid "Error al verificar la biometría. Usa tu contraseña."
msgstr "Biometric verification failed. Use your password."
