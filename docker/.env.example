MYSQL_ROOT_PASSWORD=cambia-esta-clave-root

DB_NAME=monetra
DB_USER=monetra
DB_PASSWORD=cambia-esta-clave

# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Límites para la función de backup/restore (admin).
# Si tu BD pesa más de 15 MB debes subir AMBOS valores de forma consistente:
#   MAX_CONTENT_UPLOAD_MB → límite de subida del archivo .mntrbak (Flask/nginx)
#   MAX_RESTORE_SQL_MB    → límite de descompresión del SQL dentro del respaldo
# Ejemplo para BDs de hasta 200 MB:
# MAX_CONTENT_UPLOAD_MB=200
# MAX_RESTORE_SQL_MB=1000

# Seguridad de sesión.
# false → cookies viajan por HTTP plano (deploy local o sin TLS).
# true  → cookies solo por HTTPS (reverse proxy con TLS — Nginx, Caddy, Traefik…).
# install.sh genera false por defecto; cámbialo a true al activar HTTPS.
# SESSION_COOKIE_SECURE=false

# Tiempo de inactividad antes de cerrar sesión automáticamente (segundos).
# Default: 900 (15 min).
# SESSION_INACTIVITY_TIMEOUT=900

# Orígenes CORS permitidos (separados por coma). Default: '*'
# CORS_ORIGINS=*
