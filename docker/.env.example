# Flask
FLASK_DEBUG=0
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-larga

# Base de datos MySQL (Plesk o externo)
DB_HOST=IP_O_HOSTNAME_DEL_SERVIDOR
DB_PORT=3306
DB_NAME=nombre_base_de_datos
DB_USER=usuario_db
DB_PASSWORD=password_db

# Cifrado de campos sensibles (Fernet)
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# JWT para la API
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ── Rate limiting / defensa anti fuerza-bruta en el login ─────────────────────
# Backend donde Flask-Limiter guarda los contadores por IP (login, registro,
# recuperación de contraseña). Determina si el límite se comparte entre los
# workers de gunicorn:
#
#   redis://redis:6379/0   (RECOMENDADO si la app está EXPUESTA DIRECTAMENTE a
#                          internet) contador compartido y persistente entre
#                          workers/reinicios. Requiere el servicio 'redis' del
#                          docker-compose (ya incluido). El host 'redis' es el
#                          nombre del contenedor dentro de la red del compose.
#
#   memory://              contador en memoria del proceso. NO se comparte entre
#                          workers (el límite efectivo se multiplica por la
#                          cantidad de workers) y se pierde al reiniciar. Válido
#                          solo detrás de un WAF/equipo de seguridad o en dev.
#
# Si lo dejas vacío o comentado, el compose usa redis://redis:6379/0 por defecto.
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# Valores de cada límite (sintaxis Flask-Limiter: "N per second|minute|hour|day",
# o compuesto "N per minute;M per hour"). Descomenta y ajusta solo lo que quieras
# endurecer — cualquier variable no definida usa el valor por defecto indicado.
# Tras cambiar, reinicia el contenedor 'flask' para aplicar.
#
# Si la app está EXPUESTA DIRECTAMENTE a internet (sin WAF/equipo de seguridad
# delante), se recomienda endurecer al menos LOGIN_RATE_LIMIT y API_LOGIN_RATE_LIMIT.
#LOGIN_RATE_LIMIT=5 per minute
#API_LOGIN_RATE_LIMIT=5 per minute
#MFA_VERIFY_RATE_LIMIT=5 per minute
#REGISTER_RATE_LIMIT=5 per minute
#RESEND_ACTIVATION_RATE_LIMIT=3 per 15 minute
#FORGOT_PASSWORD_RATE_LIMIT=3 per 15 minute
#RESET_PASSWORD_RATE_LIMIT=5 per 15 minute
#PIN_SET_RATE_LIMIT=10 per minute
#PIN_DELETE_RATE_LIMIT=10 per minute
#PIN_LOGIN_RATE_LIMIT=5 per minute
#BACKUP_EXPORT_RATE_LIMIT=5 per hour
#BACKUP_RESTORE_RATE_LIMIT=5 per hour
#AI_TEST_CONNECTION_RATE_LIMIT=10 per minute
# Presupuesto por chat_id (no global/por-IP) — el /start que vincula la cuenta
# siempre está exento de este límite.
#TELEGRAM_WEBHOOK_RATE_LIMIT=30 per minute
#TELEGRAM_LINK_CODE_RATE_LIMIT=5 per 10 minute

# ── Lockout de cuenta por fuerza bruta en login (password + MFA) ──────────────
# Además del rate limit por IP de arriba, la cuenta se bloquea temporalmente
# tras varios intentos fallidos (password o código MFA), sin importar la IP de
# origen — protege contra ataques distribuidos desde múltiples IPs.
# LOGIN_MAX_FAILS: intentos fallidos antes de bloquear.
# LOGIN_LOCK_MINUTES: minutos que dura el bloqueo.
#LOGIN_MAX_FAILS=3
#LOGIN_LOCK_MINUTES=30

# ── Bot de Telegram (opcional) ────────────────────────────────────────────────
# Sin estas variables la tarjeta de Telegram queda deshabilitada en Configuración.
#
# 1. Crea un bot con @BotFather → /newbot → copia el token aquí
TELEGRAM_BOT_TOKEN=
#
# 2. Username del bot sin @ (ej. MoneyTrackerBot)
#    Se usa para generar el deep link t.me/<username>?start=<código>
TELEGRAM_BOT_USERNAME=
#
# 3. Secreto para validar que los webhooks vienen de Telegram (no de terceros)
#    Genera con: python -c "import secrets; print(secrets.token_hex(32))"
TELEGRAM_WEBHOOK_SECRET=
#
# 4. URL pública del servidor — Telegram la usa para registrar el webhook al arrancar
#    En desarrollo usa ngrok: ngrok http 5000 → copia la URL https
SERVER_URL=https://tu-dominio.com
